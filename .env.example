# Database Configuration
DB_NAME=mini_blog_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Django Settings
DEBUG=True                                          # Set to False in production
SECRET_KEY=your-secret-key-here-change-in-production

# Email Configuration (Development)
# When DEBUG=True, emails are printed to console
# When DEBUG=False, configure SMTP settings below
DEFAULT_FROM_EMAIL=no-reply@mini-blog.local
BACKEND_URL=http://localhost:8000

# Email Configuration (Production - Only needed when DEBUG=False)
# Uncomment and configure these for production
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password-or-token

# Celery & Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
